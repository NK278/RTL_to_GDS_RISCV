VERSION 5.4 ;
NAMESCASESENSITIVE ON ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN PROCESSOR ;

SCANCHAINS 1 ;
  - AutoChain_1_seg1_clock_rising 
#     + PARTITION p_clock_rising 
#       MAXBITS 3
